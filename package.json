{
  "name": "@werkstatt/merit-aktiva-mcp",
  "version": "0.1.0",
  "description": "Open-source MCP server for the Merit Aktiva accounting API",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./auth": "./dist/auth.js",
    "./merit-credential-parse": "./dist/merit-credential-parse.js",
    "./api-error": "./dist/api-error.js",
    "./server-setup": "./dist/server-setup.js",
    "./logger": "./dist/logger.js",
    "./tools/*": "./dist/tools/*.js",
    "./validation/*": "./dist/validation/*.js",
    "./types/*": "./dist/types/*.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "biome check src/ vitest.config.ts vitest.integration.config.ts",
    "lint:fix": "biome check --write src/ vitest.config.ts vitest.integration.config.ts",
    "format": "biome format --write src/ vitest.config.ts vitest.integration.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:readme": "npm run build && node -e \"import('./dist/readme-tools.js').then((m) => console.log(m.writeReadmeToolTable('README.md') ? 'README tool table updated' : 'README tool table already up to date'))\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/werkstatt-jasper/merit-aktiva-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "merit-aktiva",
    "merit",
    "accounting",
    "estonia"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
