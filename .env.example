# Merit Aktiva API credentials
# Copy this file to .env and fill in real values. NEVER commit .env.
#
# API docs: https://api.merit.ee/connecting-robots/reference-manual/
# Credentials: Merit Aktiva > Settings > API Settings (admin user)

MERIT_API_ID=your_api_id
MERIT_API_KEY=your_api_key

# Base URL (default if omitted). Poland: https://program.360ksiegowosc.pl
# MERIT_BASE_URL=https://aktiva.merit.ee

# Optional HTTP retry (transient 5xx / 429 / 408 and network failures only; default 0 = off).
# Merit's rate limiter requires a fresh timestamp + signature per retry; the client does this.
# MERIT_HTTP_MAX_RETRIES=2
# MERIT_HTTP_RETRY_BASE_MS=500

# Outbound request timeout in ms (default 30000)
# MERIT_REQUEST_TIMEOUT_MS=30000

# Structured logs (stderr only; stdout is reserved for MCP)
# LOG_LEVEL=info
